      <column caption='Borough (taxi zone lookup (1).csv1)' datatype='string' name='[Borough (taxi_zone_lookup (1).csv1)]' role='dimension' type='nominal' />
      <column caption='Time of day' datatype='string' name='[Calculation_0880492334673920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=4 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=10&#13;&#10;THEN&quot;MORNING&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=11 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=16&#13;&#10;THEN&quot;AFTERNOON&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=17 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=21&#13;&#10;THEN&quot;EVENING&quot;&#13;&#10;ELSE&quot;Late Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Trip time' datatype='integer' name='[Calculation_1284012752232448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//. Ttip time&#13;&#10;DATEDIFF(&apos;minute&apos;,[lpep_pickup_datetime],[lpep_dropoff_datetime])' />
      </column>
      <column caption='Top 5 parameter' datatype='real' name='[Calculation_1284012770299919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1284012769562637]&#13;&#10;WHEN &quot;AVERAGE REVENUE&quot; THEN AVG([total_amount]) &#13;&#10;WHEN &quot;AVERAGE TIP AMOUNT&quot; THEN AVG([tip_amount])&#13;&#10;END' />
